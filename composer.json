{
    "name": "hook-shield/hook-shield",
    "description": "Automates bulletproof webhook security for PHP with signature validation, replay prevention, rate limiting and threat detection",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "webhook",
        "security",
        "hmac",
        "signature",
        "replay-protection",
        "rate-limit",
        "psr-7",
        "psr-15"
    ],
    "authors": [
        {
            "name": "Hook Shield Contributors",
            "email": "maintainers@hookshield.dev"
        }
    ],
    "require": {
        "php": "^8.2",
        "psr/http-message": "^1.1|^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "psr/cache": "^2.0|^3.0",
        "psr/log": "^2.0|^3.0",
        "symfony/cache": "^6.4|^7.0",
        "guzzlehttp/psr7": "^2.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "nyholm/psr7": "^1.8",
        "symfony/console": "^6.4|^7.0"
    },
    "autoload": {
        "psr-4": {
            "HookShield\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HookShield\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/hookshield"
    ],
    "scripts": {
        "test": "vendor/bin/phpunit --testsuite=unit,feature",
        "test:unit": "vendor/bin/phpunit --testsuite=unit",
        "test:feature": "vendor/bin/phpunit --testsuite=feature"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "suggest": {
        "symfony/console": "Required for the CLI test command",
        "nyholm/psr7": "For the plain-PHP example"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    }
}
